{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Madrid",
  "prCreation": "immediate",
  "assignees": ["mrcat71"],
  "reviewers": ["mrcat71"],
  "assignAutomerge": true,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": false,
  "pinDigests": true,
  "automerge": false,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates for CI review.",
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions", "ci"],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major Swift dependency updates.",
      "matchManagers": ["swift"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["swift"],
      "groupName": "swift dependencies (minor + patch)"
    },
    {
      "description": "Keep major Swift dependency updates separate for manual review.",
      "matchManagers": ["swift"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["swift", "major"],
      "automerge": false
    }
  ]
}
